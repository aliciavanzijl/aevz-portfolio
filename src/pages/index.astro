---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hej! 👋</div>
    <div class="text-5xl font-bold">I'm Alicia van Zijl</div>
    <div class="text-3xl py-3 font-bold">Software & Web Developer</div>
    <div class="py-2">
      <text class="text-lg">
        I'm a developer living in Stockholm, Sweden, and currently a third year
        BSc Information & Communication Technology student at KTH Royal
        Institute of Technology. I've been a self-taught hobbiest & occasional
        freelance coder for many years, but now I'm taking the plunge and making
        development my career.
      </text>
    </div>
    <div class="mt-8">
      <a
        class="btn"
        href="https://www.linkedin.com/in/alicia-van-zijl/"
        target="_blank"
      >
        Let's connect!</a
      >
      <a href="/studies" target="_blank" class="btn btn-outline ml-5">
        See Completed Courses
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">
      My Personal Favourite Projects {"</>"}
    </div>
  </div>

  <HorizontalCard
    title="Web App: Feed This Much"
    img="/logo_feedthismuch_nontransparent.png"
    desc="A group project where we created a React web app for dog and cat owners. It helps pet owners create personalized feeding plans tailored to their pets' needs based on scientific nutritional guidelines.  It calculates the amount of food to give a pet, including a combination of two different foods, and can divide this over a custom number of meals. Key Tools/Languages/Frameworks: React, JavaScript, TypeScript, Python, SQL, CSS, Figma"
    url="https://github.com/aliciavanzijl/feed-this-much"
    badge="Web App"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Swimmy Shark Game"
    img="/shark_game_short (1).gif"
    desc="A Platform Game for ChipKit uC32 and Basic I/O Shield. Key Tools/Languages/Frameworks: C."
    url="https://github.com/aliciavanzijl/swimmyshark"
    badge="C"
  />

  <!--
  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">
      The latest from my blog
    </div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
-->
</BaseLayout>
