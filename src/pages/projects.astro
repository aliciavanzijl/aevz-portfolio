---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Projects Header</div>
  </div>

  <HorizontalCard
    title="Web App: Feed This Much"
    img="/public\logo_feedthismuch_nontransparent.png"
    desc="A group project where we created a React web app for dog and cat owners. The Feed This Much web app helps pet owners create personalized feeding plans tailored to their pets' specific needs based on scientific nutritional guidelines by the European Pet Food Industry Federation (FEDIAF).  It calculates the amount of food to give a pet, including a combination of two different foods, and can divide this over a custom number of meals."
    url="https://teamrecurrent.wixsite.com/feed-this-much-expo"
    badge="TOP"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Swimmy Shark Game"
